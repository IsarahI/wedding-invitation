# =====================================================================
# invitation.conf.example
# 이 청첩장 한 건의 모든 정보가 여기 모입니다.
# src/ 아래 HTML·JS 에는 실제 값이 없고, build.sh 가 이 파일을 읽어 채워 넣습니다.
#
# 쓰는 방법
#   1) 복사:   cp invitation.conf.example invitation.conf
#   2) invitation.conf 안의 [대괄호 문구]를 실제 내용으로 바꿉니다. (대괄호도 같이 지우세요)
#   3) ./build.sh 실행 → dist/ 에 완성본이 나옵니다.   (Windows: .\build.ps1)
#
# invitation.conf 는 .gitignore 대상이라 git 에 올라가지 않습니다.
# 전화번호·계좌번호가 GitHub 저장소에 노출되는 일을 막기 위해서입니다.
#
# 적는 규칙
#   - 값은 항상 큰따옴표로 감쌉니다.            VENUE_NAME="별빛웨딩홀"
#   - 한 줄에 하나씩, 줄 끝에 주석을 달지 마세요. (# 으로 시작하는 줄만 주석입니다)
#   - 값 안의 \n 은 줄바꿈입니다.               INFO_PARKING="지하 주차장 2시간 무료\n주차권 수령 필요"
#   - 필요 없는 항목은 "" (빈 값)으로 두면 화면에서 사라집니다.
#   - 사진은 파일 이름만 적습니다. 실제 파일은 src/photos/ 에 넣으세요.
# =====================================================================


# --- 이 청첩장을 올릴 주소 ---
# 카카오톡 공유 미리보기(og:image)는 https:// 로 시작하는 전체 주소여야 사진이 나옵니다.
# 아직 모르면 비워 두세요. 화면은 정상이고 공유 카드에 사진만 빠집니다.
#   예) https://내아이디.github.io/wedding-invitation
SITE_ORIGIN=""
# 카카오톡·문자로 공유할 때 제목 아래 보이는 한 줄. 예) 2027년 4월 24일 낮 12시 · 별빛웨딩홀
OG_DESCRIPTION="[예식 일시] · [예식장 이름]"
# 공유 미리보기 사진 (파일 이름). 비우면 PHOTO_COVER 를 씁니다.
PHOTO_OG=""

# 화면 모드: auto(기기 설정을 따름) | light | dark
DEFAULT_THEME="auto"

# 축하 한마디를 받을 API 주소. 비우면 방명록 칸이 나오지 않습니다.
# with-guestbook 구성은 이 값을 자동으로 "/api" 로 채웁니다. static 구성에서는 비워 두세요.
GUESTBOOK_API_BASE=""


# --- 신랑 ---
GROOM_NAME="[신랑 이름]"
GROOM_NAME_EN="[신랑 영문이름]"
GROOM_ROLE="[신랑 직업 / 하는 일]"
GROOM_FATHER="[신랑 아버지 성함]"
GROOM_MOTHER="[신랑 어머니 성함]"
GROOM_RANK="[장남 / 차남 / 아들 중 하나]"
# 위 서열을 코드 표현으로 옮긴 장식 문구. 예) sons[1]   (비우면 숨김)
GROOM_RANK_EXPR=""
GROOM_MBTI="[MBTI]"
GROOM_HOBBY="[취미1, 취미2]"
# 코드 주석처럼 보이는 한 줄. 예) // always on-call for her
GROOM_NOTE="[신랑 한 줄 코멘트]"
GROOM_PHONE="[신랑 연락처]"
GROOM_FATHER_PHONE="[신랑 아버지 연락처]"
GROOM_MOTHER_PHONE="[신랑 어머니 연락처]"
# 사진 파일 이름 (src/photos/ 안에 넣습니다)
GROOM_PHOTO="groom.jpg"


# --- 신부 ---
BRIDE_NAME="[신부 이름]"
BRIDE_NAME_EN="[신부 영문이름]"
BRIDE_ROLE="[신부 직업 / 하는 일]"
BRIDE_FATHER="[신부 아버지 성함]"
BRIDE_MOTHER="[신부 어머니 성함]"
BRIDE_RANK="[장녀 / 차녀 / 딸 중 하나]"
BRIDE_RANK_EXPR=""
BRIDE_MBTI="[MBTI]"
BRIDE_HOBBY="[취미1, 취미2]"
BRIDE_NOTE="[신부 한 줄 코멘트]"
BRIDE_PHONE="[신부 연락처]"
BRIDE_FATHER_PHONE="[신부 아버지 연락처]"
BRIDE_MOTHER_PHONE="[신부 어머니 연락처]"
BRIDE_PHOTO="bride.jpg"


# --- 예식 일시 ---
# 형식: 년-월-일T시:분:00+09:00
#   예) 2027년 4월 24일 낮 12시  →  2027-04-24T12:00:00+09:00
# 비워 두면 달력·카운트다운 대신 [예식 일시] 가 표시됩니다.
WEDDING_AT=""
# 두 사람이 처음 만난 날(선택). 예) 2021-03-14   비우면 진행률 막대가 숨겨집니다.
FIRST_MET_AT=""


# --- 예식장 ---
VENUE_NAME="[예식장 이름]"
VENUE_HALL="[홀 이름 · 층]"
VENUE_ADDRESS="[예식장 주소]"
VENUE_PHONE="[예식장 전화번호]"
# 지도 버튼. 비우면 위 주소로 자동 검색합니다. 특정 지도 링크를 쓰고 싶을 때만 적으세요.
MAP_NAVER_URL=""
MAP_KAKAO_URL=""


# --- 오시는 길 안내 (필요 없는 줄은 "") ---
INFO_SUBWAY="[지하철 안내]"
INFO_BUS="[버스 안내]"
INFO_PARKING="[주차 안내]"
INFO_MEAL="[식사 안내]"


# --- 문구 ---
GREETING_TITLE="[인사말 제목]"
GREETING_TEXT="[인사말 첫째 줄]\n[인사말 둘째 줄]\n[인사말 셋째 줄]"
CLOSING_TEXT="[마무리 문구]"


# --- 사진 (파일 이름만. 실제 파일은 src/photos/ 에) ---
PHOTO_COVER="cover.jpg"
PHOTO_CLOSING="closing.jpg"
# 갤러리: 쉼표로 구분. 장수는 자유롭게 늘리고 줄이세요.
PHOTO_GALLERY="g01.jpg,g02.jpg,g03.jpg,g04.jpg,g05.jpg,g06.jpg,g07.jpg,g08.jpg,g09.jpg"


# --- 계좌 ---
# 형식: 관계|이름|은행|계좌번호      사람은 쉼표로 구분합니다.
# 사람을 늘리거나 줄이려면 쉼표로 구분된 항목만 더하거나 빼면 됩니다.
# 값 안에는 | 와 , 를 쓰지 않습니다. 계좌 안내를 숨기려면 "" 로 비웁니다.
#
# 이 값은 난독화해서 dist/js/data.js 에 넣습니다. 그래서 결과물 어느 파일에도 평문 계좌번호가
# 남지 않고, 하객이 '마음 전하실 곳'을 펼칠 때에만 화면에 그려집니다.
# 주의: 난독화는 암호화가 아닙니다. 브라우저가 풀어야 하므로 마음먹은 사람은 읽을 수 있습니다.
#       목적은 검색 엔진 노출과 자동 수집을 막는 것입니다.
GROOM_ACCOUNTS="신랑|[신랑 이름]|[은행]|[계좌번호],신랑 아버지|[신랑 아버지 성함]|[은행]|[계좌번호],신랑 어머니|[신랑 어머니 성함]|[은행]|[계좌번호]"
BRIDE_ACCOUNTS="신부|[신부 이름]|[은행]|[계좌번호],신부 아버지|[신부 아버지 성함]|[은행]|[계좌번호],신부 어머니|[신부 어머니 성함]|[은행]|[계좌번호]"


# --- 참석 여부 ---
# true 면 하객이 입력한 내용이 문자 작성창에 채워집니다 (신랑측 → 신랑 연락처, 신부측 → 신부 연락처).
RSVP_ENABLED="true"
